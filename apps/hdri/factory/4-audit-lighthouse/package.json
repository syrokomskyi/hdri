    "@syrokomskyi/utils": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "better-sqlite3": "^13.0.3",
    "chrome-launcher": "^1.2.1",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.4.1",
    "markdown-table": "^3.0.4",
