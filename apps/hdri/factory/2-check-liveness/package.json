{
  "name": "@syrokomskyi/site-liveness",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../../../.. exec tsc -b apps/hdri/factory/2-check-liveness/tsconfig.json --pretty false",
    "typecheck": "pnpm --dir ../../../.. exec tsc -b apps/hdri/factory/2-check-liveness/tsconfig.json --pretty false",
    "test": "pnpm --dir ../../../.. exec vitest run --config apps/hdri/factory/2-check-liveness/vitest.config.ts",
    "dev": "tsx -C @syrokomskyi/source watch run/run.ts",
    "start": "tsx -C @syrokomskyi/source run/run.ts",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init",
    "capture:preflight": "tsx -C @syrokomskyi/source run/preflight.ts"
  },
  "dependencies": {
    "@syrokomskyi/business-core": "workspace:*",
    "@syrokomskyi/business-crawler": "workspace:*",
    "@syrokomskyi/factory-core": "workspace:*",
    "@syrokomskyi/observatory-core": "workspace:*",
    "@syrokomskyi/observatory-crypto": "workspace:*",
    "@syrokomskyi/observatory-emit": "workspace:*",
    "@warpgogol/pipeline-core": "workspace:*",
    "@warpgogol/pipeline-node": "workspace:*",
    "@syrokomskyi/pipeline-steps-hdri": "workspace:*",
    "@syrokomskyi/utils": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@warpgogol/changelog-live": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "markdown-table": "^3.0.4",
    "tsx": "^4.23.7"
  }
}
