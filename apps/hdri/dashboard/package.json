{
  "name": "@syrokomskyi/dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "export:data": "pnpm --filter @syrokomskyi/observatory run export:dashboard",
    "build": "astro build",
    "start": "astro dev",
    "dev": "astro dev",
    "preview": "pnpm --dir ../../.. exec astro preview --root apps/hdri/dashboard",
    "typecheck": "pnpm --dir ../../.. exec astro sync --root apps/hdri/dashboard && pnpm --dir ../../.. exec tsc -p apps/hdri/dashboard/tsconfig.json --noEmit",
    "upgrade-packages": "pnpm up --latest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.1.7",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@tanstack/table-core": "^8.21.3",
    "astro": "^7.1.6",
    "cookie": "^2.0.1",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "katex": "^0.18.1",
    "lenis": "^1.3.25",
    "topojson-client": "^3.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^26.1.2",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "wrangler": "^4.118.0"
  }
}
