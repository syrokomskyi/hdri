---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/faq.css";
import Term from "../components/Term.astro";
import { site, ogImage, publisher } from "../lib/seo";
import { count, pct } from "../lib/format";
import { getSiteMeta } from "../data/site-meta";

const meta = getSiteMeta();
const cb = meta.codebook;
const currentManifest = meta.manifest;
const currentOverview = meta.overview;
const totalIndicators = meta.indicatorCount;

const pageTitle = "Häufig gestellte Fragen — HDRI Dashboard";
const pageDescription = "FAQ zum HDRI: Fragen und Antworten zum Handwerk Digital Reife Index.";

const schema = {
  "@type": "FAQPage",
  image: ogImage,
  inLanguage: "de-DE",
  publisher: publisher(),
  mainEntity: [
    {
      "@type": "Question",
      name: "Was ist der HDRI?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der HDRI (Handwerk Digital Reife Index) ist ein öffentlicher, deskriptiver Quartalsindex, der die digitale Reife von Handwerkswebsites in Deutschland auf Basis öffentlich zugänglicher Signale messbar macht. Er dient als methodische Orientierung für Regionen, Branchen und Entwickler digitaler Infrastruktur.",
      },
    },
    {
      "@type": "Question",
      name: "Was misst der HDRI — und was misst er nicht?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der HDRI misst ausschließlich automatisch erfassbare, öffentlich sichtbare Signale der digitalen Präsenz von Handwerksbetrieben: Barrierefreiheit, rechtliche Pflichtangaben, Kontaktmöglichkeiten, soziale Netzwerke, Vertrauensnachweise und strukturierte Daten. Er misst nicht: Qualität von Inhalten oder Usability, Geschäftserfolg oder Umsatz, Kundenzufriedenheit oder Bewertungen, Vollständigkeit des gesamten digitalen Auftritts, Echtzeit-Daten (nur quartalsweise Snapshots). Der HDRI ist kein Ranking einzelner Betriebe und kein SEO-Score.",
      },
    },
    {
      "@type": "Question",
      name: "Wie oft wird der Index aktualisiert?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der Index erscheint einmal pro Quartal. Pro Quartal gibt es genau einen veröffentlichten, kanonischen Index. Vergleiche zwischen Quartalen werden nur dann angezeigt, wenn sie statistisch zuverlässig sind.",
      },
    },
    {
      "@type": "Question",
      name: "Wer steht hinter dem HDRI?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der HDRI ist ein privates, unabhängiges Projekt einer Privatperson mit Wohnsitz in Deutschland. Es besteht keine Verbindung zu Handwerkskammern, Verbänden, Behörden oder kommerziellen Anbietern.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Daten liegen dem Index zugrunde?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Grundlage sind öffentlich zugängliche Websites deutscher Handwerksbetriebe. Die Signale werden durch automatisierte Extraktoren aus HTML, strukturierten Daten (Schema.org) und Metadaten gelesen. Es werden keine Login-Seiten, internen Systeme oder bezahlten APIs verwendet.",
      },
    },
    {
      "@type": "Question",
      name: "Wie groß ist die Stichprobe?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Aktuell (${currentManifest.period}) umfasst die Stichprobe ${count(currentOverview.sampleSize)} Websites. Die Stichprobe enthält alle öffentlich erreichbaren Handwerkswebsites, die im jeweiligen Quartal erfolgreich gecrawlt werden konnten.`,
      },
    },
    {
      "@type": "Question",
      name: "Warum sind nicht alle erfassten Domains im Dashboard sichtbar?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Im Dashboard werden ausschließlich Aggregate veröffentlicht, die die Publikationsschwelle erfüllen (mindestens n ≥ ${meta.kAnonymityMin} Fälle pro Slice). Einzelne Betriebe, Domains, URLs oder individuelle Scores werden nie veröffentlicht. Zu kleine Gruppen (z. B. seltene Gewerke in dünn besiedelten Regionen) werden unterdrückt. Die Schwelle reduziert das Risiko einer indirekten Zuordnung einzelner Betriebe und erhöht zugleich die statistische Stabilität kleiner Gruppen.`,
      },
    },
    {
      "@type": "Question",
      name: "Werden personenbezogene Daten verarbeitet oder veröffentlicht?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nein. Alle Rohdaten werden anonymisiert, bevor sie in den Index einfließen. Der veröffentlichte Index enthält ausschließlich aggregierte, nicht personenbezogene Kennzahlen. Keine Domains, URLs, Asset-IDs oder Einzelscores werden veröffentlicht.",
      },
    },
    {
      "@type": "Question",
      name: "Was passiert mit inaktiven Websites?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Domains, die bei mehreren aufeinanderfolgenden Crawl-Versuchen nicht erreichbar sind, werden aus der aktiven Stichprobe entfernt.",
      },
    },
    {
      "@type": "Question",
      name: "Wie wird der HDRI-Score berechnet?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Berechnung erfolgt in drei Stufen: 1. Indikator-Score: Jeder Indikator übersetzt einen rohen Signalwert in einen Score zwischen 0 und 100 (Regeltypen: bool, presence, countClamp, countClampInverse, enum). 2. Dimensions-Score: Gewichtetes arithmetisches Mittel aller Indikatoren einer Dimension. Fehlende Indikatoren (skip) reduzieren das effektive Gewicht. 3. Overall HDRI-Score: Gewichtetes arithmetisches Mittel aller sechs Dimensions-Scores. Wenn eine Dimension vollständig fehlt, wird ihr Gewicht auf die übrigen umverteilt.",
      },
    },
    {
      "@type": "Question",
      name: "Welche sechs Dimensionen gibt es und wie sind sie gewichtet?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Recht und Pflichtangaben (${pct(meta.codebook.dimensions.find((d) => d.id === "legal_compliance")?.weight ?? 0)}): Impressum, Datenschutz, AGB, BFSG, Widerruf, Versand. Kontakt und Erreichbarkeit (${pct(meta.codebook.dimensions.find((d) => d.id === "contact_accessibility")?.weight ?? 0)}): Telefon, E-Mail, Adresse, Öffnungszeiten, Kontaktformular. Barrierefreiheit (${pct(meta.codebook.dimensions.find((d) => d.id === "accessibility_audit")?.weight ?? 0)}): WCAG-Konformität via Axe-Core (kritische bis geringe Fehler). Strukturierte Informationen (${pct(meta.codebook.dimensions.find((d) => d.id === "structured_data")?.weight ?? 0)}): Schema.org-Markup, LocalBusiness, FAQ, Service, Breadcrumbs. Vertrauen und Nachweise (${pct(meta.codebook.dimensions.find((d) => d.id === "trust_signals")?.weight ?? 0)}): Zertifizierungen, Meistertitel, Auszeichnungen, Mitgliedschaften. Soziale Präsenz (${pct(meta.codebook.dimensions.find((d) => d.id === "social_presence")?.weight ?? 0)}): Verlinkung auf Facebook, Instagram, YouTube, LinkedIn u. a.`,
      },
    },
    {
      "@type": "Question",
      name: "Warum wird P75 als primäre Kennzahl verwendet und nicht der Median?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der Median (P50) beschreibt das typische Niveau der Stichprobe. P75 beschreibt das Niveau, das die besten 25 % der Websites erreichen — es ist ein ambitionierterer, aber realistischer Benchmark für Betriebe, die ihre digitale Präsenz verbessern wollen. Zudem ist P75 robuster gegenüber Ausreißern als der Mittelwert.",
      },
    },
    {
      "@type": "Question",
      name: "Was bedeutet der IQR (Interquartilsabstand)?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der IQR (P75 − P25) umfasst die mittleren 50 % aller Werte der Stichprobe. Ein enger IQR bedeutet, dass die meisten Websites ähnliche Scores aufweisen. Ein breiter IQR weist auf heterogene Qualität innerhalb der Gruppe hin.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist die Confidence (Vertrauensniveau)?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Confidence-Skala zeigt, wie verlässlich ein gemessener Wert ist: 1,0 bedeutet Signal wurde direkt beobachtet und erfolgreich extrahiert. 0,5 bedeutet Signal wurde imputiert (geschätzt) aufgrund fehlender Daten. 0,0 bedeutet Signal wurde übersprungen und fließt nicht in den Score ein. Confidence ist nicht gleich statistische Signifikanz — sie misst Datenverfügbarkeit, nicht Modellgüte.",
      },
    },
    {
      "@type": "Question",
      name: "Werden einzelne Betriebe bewertet oder gelistet?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nein. Das Dashboard zeigt ausschließlich aggregierte Kennzahlen für Gruppen (Regionen, Gewerke). Einzelne Betriebe, Websites oder Scores werden weder gespeichert noch veröffentlicht.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist die Publikationsschwelle und warum wird sie eingesetzt?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Ergebnisse für Gruppen mit weniger als ${meta.kAnonymityMin} beobachteten Websites werden nicht veröffentlicht. Wenn eine Gruppe (z. B. ein bestimmtes Gewerk in einem Bundesland) weniger als ${meta.kAnonymityMin} Fälle enthält, wird sie im Dashboard nicht angezeigt. Für Kreuztabellen (Region × Gewerk) gelten noch strengere Anforderungen. Die Schwelle reduziert das Risiko einer indirekten Zuordnung einzelner Betriebe und erhöht zugleich die statistische Stabilität kleiner Gruppen.`,
      },
    },
    {
      "@type": "Question",
      name: "Warum werden manche Deltas (Quartalsvergleiche) nicht angezeigt?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ein Delta wird unterdrückt, wenn: die Änderung kleiner als 3 Punkte oder kleiner als 3 % relativ zum Vorquartal ist, eine der Vergleichsstichproben die Publikationsschwelle unterschreitet, oder eine Kategorie in einem der Quartale nicht vorhanden war. Das ist kein Fehler — es ist ein gezielter Schutzmechanismus.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist das Codebook?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Das Codebook ist die vollständige, maschinenlesbare Scoring-Spezifikation des HDRI. Es enthält alle Dimensionen, Indikatoren, Gewichtungen, Scoring-Regeln und Missing-Value-Policies. Das aktuelle Codebook ist ${cb.id}, Version ${cb.version} (${totalIndicators} Indikatoren in ${cb.dimensions.length} Dimensionen).`,
      },
    },
    {
      "@type": "Question",
      name: "Wie funktioniert die Versionierung des Codebooks?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Das Codebook folgt semantischer Versionierung (MAJOR.MINOR.PATCH): MAJOR bedeutet inkompatible Änderung (Indikator entfernt, Dimension umbenannt) — Vergleiche mit Vorversionen sind nicht möglich. MINOR bedeutet additive Änderung (neuer Indikator, neue Dimension) — rückwärtskompatibel. PATCH bedeutet Beschreibung oder Tippfehler, keine Scoring-Auswirkung.",
      },
    },
    {
      "@type": "Question",
      name: "Kann ich den Index selbst reproduzieren?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Ja, theoretisch. Die Scoring-Engine, der Codebook-Parser und die Aggregationslogik sind als @syrokomskyi/hdri-codebook Open-Source verfügbar. Das Codebook steht auch als YAML-Datei zum Download bereit (codebook-observatory-${cb.version}.yaml). Eine vollständige Reproduktion setzt den Zugang zu denselben Quelldaten voraus.`,
      },
    },
    {
      "@type": "Question",
      name: "Was bedeutet deskriptiv — werden keine statistischen Tests durchgeführt?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Korrekt. Der HDRI verwendet ausschließlich deskriptive Statistik — er beschreibt die vorliegende Stichprobe, macht aber keine Aussagen über die Grundgesamtheit aller deutschen Handwerksbetriebe. Es werden keine p-Werte, Konfidenzintervalle oder Hypothesentests berechnet. Die Aussagekraft basiert auf der Stichprobengröße (N = ${count(meta.sampleSize)}), nicht auf inferenzstatistischen Verfahren.`,
      },
    },
    {
      "@type": "Question",
      name: "Warum fehlen manche Websites in der Stichprobe?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Websites mit starkem Bot-Schutz (z. B. HTTP-403-Fehler oder Anti-Bot-Systeme) werden unterrepräsentiert, da der Crawler keinen Zugriff erhält. Außerdem können JavaScript-lastige Single-Page-Apps (SPAs) nicht vollständig analysiert werden, da die Extraktion auf statischem HTML basiert.",
      },
    },
    {
      "@type": "Question",
      name: "Können automatisierte Messungen falsch liegen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja. Automatisierte Extraktion kann falsch-positive und falsch-negative Ergebnisse liefern. Ein fehlendes Signal bedeutet nicht immer, dass ein Merkmal tatsächlich fehlt — es kann auch bedeuten, dass es nicht automatisch erkannt wurde. Die Confidence-Werte geben einen Hinweis auf die Datenverfügbarkeit.",
      },
    },
    {
      "@type": "Question",
      name: "Ist der HDRI repräsentativ für alle Handwerksbetriebe in Deutschland?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der HDRI beschreibt seine Stichprobe (öffentlich erreichbare Handwerkswebsites), macht aber keine repräsentativen Aussagen über die Grundgesamtheit aller Betriebe — insbesondere über Betriebe ohne Website oder mit nicht-erreichbaren Websites.",
      },
    },
    {
      "@type": "Question",
      name: "Ist der HDRI ein offizielles oder staatliches Projekt?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nein. Der HDRI ist ein privates, unabhängiges Forschungsprojekt. Es besteht keine Verbindung zu Ministerien, Behörden, Handwerkskammern oder Fachverbänden. Die Klassifizierung der Gewerke folgt jedoch der Handwerksordnung (HWO) und der Einteilung des Statistischen Bundesamts (Destatis).",
      },
    },
    {
      "@type": "Question",
      name: "Wie zitiere ich den HDRI?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Bitte zitieren Sie den HDRI als: Syrokomskyi, A. (2026). Handwerk Digital Reife Index (HDRI), Quartal ${currentManifest.period}, Codebook v${cb.version}. URL: https://handwerk-index.org. DOI: https://doi.org/10.5281/zenodo.20478155.`,
      },
    },
    {
      "@type": "Question",
      name: "Wie melde ich einen Fehler oder eine Korrektur?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Fehlermeldungen und Korrekturen können per E-Mail an andrii@syrokomskyi.com oder über das öffentliche GitHub-Repository (github.com/syrokomskyi/hdri) gemeldet werden.",
      },
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <main>
    <div class="container">
      <Breadcrumbs items={[{ label: "HDRI Dashboard", href: "/" }, { label: "Häufige Fragen" }]} />
    </div>

    <section class="hero">
      <div class="container hero-panel layer-accent">
        <div class="hero-copy">
          <span class="eyebrow">FAQ</span>
          <h1>Häufig gestellte Fragen</h1>
          <p>Antworten auf die wichtigsten Fragen zum HDRI — dem Handwerk Digital Reife Index.</p>
          <div class="hero-actions">
            <a class="button" href="/">Zum Dashboard</a>
            <a class="button button-secondary" href="/methodik">Methodik</a>
            <a class="button button-secondary" href="/glossar">Glossar</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="faq-section-title">Über den HDRI</h2>
        <div class="faq-grid">
          <article class="faq-card layer-accent">
            <h3>Was ist der HDRI?</h3>
            <p>
              Der HDRI (Handwerk Digital Reife Index) ist ein öffentlicher, deskriptiver
              Quartalsindex, der die digitale Reife von Handwerkswebsites in Deutschland auf Basis
              öffentlich zugänglicher Signale messbar macht. Er dient als methodische Orientierung
              für Regionen, Branchen und Entwickler digitaler Infrastruktur.
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Was misst der HDRI — und was misst er nicht?</h3>
            <p>
              Der HDRI misst ausschließlich automatisch erfassbare, öffentlich sichtbare Signale der
              digitalen Präsenz von Handwerksbetrieben: Barrierefreiheit, rechtliche Pflichtangaben,
              Kontaktmöglichkeiten, soziale Netzwerke, Vertrauensnachweise und strukturierte Daten.
            </p>
            <p>
              Er misst <strong>nicht</strong>: Qualität von Inhalten oder Usability, Geschäftserfolg
              oder Umsatz, Kundenzufriedenheit oder Bewertungen, Vollständigkeit des gesamten
              digitalen Auftritts, Echtzeit-Daten (nur quartalsweise Snapshots).
            </p>
            <p>Der HDRI ist kein Ranking einzelner Betriebe und kein SEO-Score.</p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Wie oft wird der Index aktualisiert?</h3>
            <p>
              Der Index erscheint einmal pro Quartal. Pro Quartal gibt es genau einen
              veröffentlichten, kanonischen Index. Vergleiche zwischen Quartalen werden nur dann
              angezeigt, wenn sie statistisch zuverlässig sind.
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Wer steht hinter dem HDRI?</h3>
            <p>
              Der HDRI ist ein privates, unabhängiges Projekt einer Privatperson mit Wohnsitz in
              Deutschland. Es besteht keine Verbindung zu Handwerkskammern, Verbänden, Behörden oder
              kommerziellen Anbietern.
            </p>
          </article>
        </div>

        <h2 class="faq-section-title">Datengrundlage</h2>
        <div class="faq-grid">
          <article class="faq-card layer-accent">
            <h3>Welche Daten liegen dem Index zugrunde?</h3>
            <p>
              Grundlage sind öffentlich zugängliche Websites deutscher Handwerksbetriebe. Die
              Signale werden durch automatisierte Extraktoren aus HTML, strukturierten Daten
              (Schema.org) und Metadaten gelesen. Es werden keine Login-Seiten, internen Systeme
              oder bezahlten APIs verwendet.
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Wie groß ist die <Term id="stichprobe">Stichprobe</Term>?</h3>
            <p>
              Aktuell ({currentManifest.period}) umfasst die Stichprobe <strong
                >{count(currentOverview.sampleSize)} Websites</strong
              >. Die Stichprobe enthält alle öffentlich erreichbaren Handwerkswebsites, die im
              jeweiligen Quartal erfolgreich gecrawlt werden konnten.
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Warum sind nicht alle erfassten Domains im Dashboard sichtbar?</h3>
            <p>
              Im Dashboard werden ausschließlich Aggregate veröffentlicht, die die
              Publikationsschwelle erfüllen (mindestens n ≥
              {meta.kAnonymityMin} Fälle pro Slice). Einzelne Betriebe, Domains, URLs oder individuelle
              Scores werden nie veröffentlicht. Zu kleine Gruppen (z. B. seltene Gewerke in dünn besiedelten
              Regionen) werden unterdrückt. Die Schwelle reduziert das Risiko einer indirekten Zuordnung
              einzelner Betriebe und erhöht zugleich die statistische Stabilität kleiner Gruppen.
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Werden personenbezogene Daten verarbeitet oder veröffentlicht?</h3>
            <p>
              Nein. Alle Rohdaten werden anonymisiert, bevor sie in den Index einfließen. Der
              veröffentlichte Index enthält ausschließlich aggregierte, nicht personenbezogene
              Kennzahlen. Keine Domains, URLs, Asset-IDs oder Einzelscores werden veröffentlicht.
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Was passiert mit inaktiven Websites?</h3>
            <p>
              Domains, die bei mehreren aufeinanderfolgenden Crawl-Versuchen nicht erreichbar sind,
              werden aus der aktiven Stichprobe entfernt.
            </p>
          </article>
        </div>

        <h2 class="faq-section-title">Scoring & Berechnung</h2>
        <div class="faq-grid">
          <article class="faq-card layer-accent">
            <h3>Wie wird der HDRI-Score berechnet?</h3>
            <p>Die Berechnung erfolgt in drei Stufen:</p>
            <ol>
              <li>
                <strong>Indikator-Score:</strong> Jeder Indikator übersetzt einen rohen Signalwert in
                einen Score zwischen 0 und 100 (Regeltypen: <code>bool</code>, <code>presence</code
                >, <code>countClamp</code>, <code>countClampInverse</code>, <code>enum</code>).
              </li>
              <li>
                <strong>Dimensions-Score:</strong> Gewichtetes arithmetisches Mittel aller Indikatoren
                einer Dimension. Fehlende Indikatoren (<code>skip</code>) reduzieren das effektive
                Gewicht.
              </li>
              <li>
                <strong>Overall HDRI-Score:</strong> Gewichtetes arithmetisches Mittel aller sechs Dimensions-Scores.
                Wenn eine Dimension vollständig fehlt, wird ihr Gewicht auf die übrigen umverteilt.
              </li>
            </ol>
            <p class="faq-cross-link">
              → Ausführliche Dokumentation: <a href="/methodik#scoring">Methodik: Scoring-Modell</a>
            </p>
          </article>

          <article class="faq-card layer-accent">
            <h3>Welche sechs Dimensionen gibt es und wie sind sie gewichtet?</h3>
            <div class="faq-table-wrap" tabindex="0">
              <table data-sortable>
                <thead>
                  <tr
                    ><th data-sort-type="text" data-col-id="dimension">Dimension</th><th
                      class="numeric"
                      data-sort-type="number"
                      data-col-id="weight">Gewicht</th
                    ><th data-sort-type="text" data-col-id="measures">Was sie misst</th></tr
                  >
                </thead>
                <tbody>
                  <tr
                    ><td data-sort-value="Recht & Pflichtangaben">Recht & Pflichtangaben</td><td
                      class="numeric"
                      data-sort-value={meta.codebook.dimensions.find(
                        (d) => d.id === "legal_compliance",
                      )?.weight ?? 0}
                      >{
                        pct(
                          meta.codebook.dimensions.find((d) => d.id === "legal_compliance")
                            ?.weight ?? 0,
                        )
                      }</td
                    ><td data-sort-value="Impressum, Datenschutz, AGB, BFSG, Widerruf, Versand"
                      ><Term id="impressum">Impressum</Term>, Datenschutz, AGB, BFSG, Widerruf,
                      Versand</td
                    ></tr
                  >
                  <tr
                    ><td data-sort-value="Kontakt & Erreichbarkeit">Kontakt & Erreichbarkeit</td><td
                      class="numeric"
                      data-sort-value={meta.codebook.dimensions.find(
                        (d) => d.id === "contact_accessibility",
                      )?.weight ?? 0}
                      >{
                        pct(
                          meta.codebook.dimensions.find((d) => d.id === "contact_accessibility")
                            ?.weight ?? 0,
                        )
                      }</td
                    ><td data-sort-value="Telefon, E-Mail, Adresse, Öffnungszeiten, Kontaktformular"
                      >Telefon, E-Mail, Adresse, Öffnungszeiten, Kontaktformular</td
                    ></tr
                  >
                  <tr
                    ><td data-sort-value="Strukturierte Informationen"
                      >Strukturierte Informationen</td
                    ><td
                      class="numeric"
                      data-sort-value={meta.codebook.dimensions.find(
                        (d) => d.id === "structured_data",
                      )?.weight ?? 0}
                      >{
                        pct(
                          meta.codebook.dimensions.find((d) => d.id === "structured_data")
                            ?.weight ?? 0,
                        )
                      }</td
