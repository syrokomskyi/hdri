{
  "name": "@syrokomskyi/observatory",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../../.. exec tsc -b apps/hdri/observatory/tsconfig.json --pretty false",
    "lint": "pnpm exec eslint run --ext .ts",
    "typecheck": "pnpm --dir ../../.. exec tsc -b apps/hdri/observatory/tsconfig.json --pretty false",
    "dev": "tsx -C @syrokomskyi/source watch run/main.ts",
    "start": "tsx -C @syrokomskyi/source run/main.ts",
    "export:dashboard": "tsx -C @syrokomskyi/source tools/export-dashboard-archive.ts",
    "validate": "tsx -C @syrokomskyi/source tools/validate-observatory.ts",
    "validate:staging": "tsx -C @syrokomskyi/source tools/validate-observatory.ts --db-dir .output/db/staging",
    "frame:validate": "tsx -C @syrokomskyi/source tools/validate-frame.ts",
    "frame:import": "tsx -C @syrokomskyi/source tools/import-population-frame.ts",
    "quarter:rebuild-verify": "tsx -C @syrokomskyi/source tools/quarter-rebuild-verify.ts",
    "quarter:validate": "tsx -C @syrokomskyi/source tools/quarter-validate.ts",
    "quarter:release": "tsx -C @syrokomskyi/source tools/quarter-release.ts",
    "quarter:release-status": "tsx -C @syrokomskyi/source tools/quarter-release-status.ts",
    "quarter:init": "tsx -C @syrokomskyi/source tools/quarter-init.ts",
    "quarter:inspect": "tsx -C @syrokomskyi/source tools/quarter-inspect.ts",
    "promote": "tsx -C @syrokomskyi/source tools/promote-to-canonical.ts",
    "gc:superseded": "tsx -C @syrokomskyi/source tools/gc-superseded.ts",
    "tier:obs-json": "tsx -C @syrokomskyi/source tools/tier-obs-json.ts",
    "tier:obs-json:rehydrate": "tsx -C @syrokomskyi/source tools/tier-obs-json.ts --rehydrate",
    "snapshot:methodology": "tsx -C @syrokomskyi/source tools/snapshot-methodology.ts",
    "snapshot:methodology:verify": "tsx -C @syrokomskyi/source tools/snapshot-methodology.ts --verify",
    "methodology:changelog": "tsx -C @syrokomskyi/source tools/methodology-changelog.ts",
    "backfill:methodology": "tsx -C @syrokomskyi/source tools/backfill-methodology.ts",
    "backfill:identity": "tsx -C @syrokomskyi/source tools/backfill-identity-registry.ts",
    "backfill:codebook-version": "tsx -C @syrokomskyi/source tools/backfill-codebook-version.ts",
    "snapshot:create": "tsx -C @syrokomskyi/source tools/snapshot-canonical.ts",
    "snapshot:verify": "tsx -C @syrokomskyi/source tools/snapshot-canonical.ts --verify",
    "rebuild:vault": "tsx -C @syrokomskyi/source tools/rebuild-from-vault.ts",
    "verify:vault": "tsx -C @syrokomskyi/source run/verify-vault.ts",
    "verify:shards": "tsx -C @syrokomskyi/source tools/verify-vault-shards.ts",
    "backfill:vault-manifest": "tsx -C @syrokomskyi/source tools/backfill-vault-manifest.ts",
    "replicate:vault": "tsx -C @syrokomskyi/source tools/replicate-vault.ts",
    "timestamp:publication": "tsx -C @syrokomskyi/source tools/timestamp-publication.ts",
    "timestamp:publication:verify": "tsx -C @syrokomskyi/source tools/timestamp-publication.ts --verify",
    "timestamp:publication:upgrade": "tsx -C @syrokomskyi/source tools/timestamp-publication.ts --upgrade",
    "start:and:build": "pnpm run build && pnpm run start",
    "test": "pnpm exec vitest run",
    "upgrade-packages": "pnpm up --latest",
    "stream:rehearse": "tsx -C @syrokomskyi/source tools/streaming-rehearsal.ts",
    "quarter:rehearse": "tsx -C @syrokomskyi/source tools/quarter-rehearsal.ts",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init",
    "preserve:q2": "tsx -C @syrokomskyi/source tools/preservation/cli.ts preserve:q2",
    "preserve:verify": "tsx -C @syrokomskyi/source tools/preservation/cli.ts preserve:verify",
    "baseline:import": "tsx -C @syrokomskyi/source tools/preservation/cli.ts baseline:import",
    "quarter:status": "tsx -C @syrokomskyi/source tools/quarter-status.ts",
    "quarter:readiness": "tsx -C @syrokomskyi/source tools/quarter-readiness.ts",
    "preservation:check": "tsx -C @syrokomskyi/source tools/preservation-check.ts"
  },
  "dependencies": {
    "@syrokomskyi/business-core": "workspace:*",
    "@syrokomskyi/factory-core": "workspace:*",
    "@syrokomskyi/hdri-codebook": "workspace:*",
    "@syrokomskyi/observatory-core": "workspace:*",
    "@syrokomskyi/observatory-crypto": "workspace:*",
    "@syrokomskyi/observatory-emit": "workspace:*",
    "@syrokomskyi/observatory-vault": "workspace:*",
    "@warpgogol/pipeline-core": "workspace:*",
    "@warpgogol/pipeline-node": "workspace:*",
    "@warpgogol/pipeline-steps": "workspace:*",
    "@syrokomskyi/utils": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "markdown-table": "^3.0.4",
    "opentimestamps": "^0.4.9",
    "tsx": "^4.23.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@warpgogol/changelog-live": "workspace:*",
    "eslint": "~10.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  }
}
