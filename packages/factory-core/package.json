{
  "name": "@syrokomskyi/factory-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "pnpm exec tsc -p tsconfig.build.json --noEmit",
    "upgrade-packages": "pnpm up --latest",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@syrokomskyi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@syrokomskyi/business-core": "workspace:*",
    "@syrokomskyi/observatory-crypto": "workspace:*",
    "@syrokomskyi/observatory-emit": "workspace:*",
    "@syrokomskyi/pipeline-core": "workspace:*",
    "@syrokomskyi/pipeline-node": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "eslint": "~10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  }
}
