{
  "name": "@warpgogol/pipeline-ai",
  "version": "0.1.6",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/syrokomskyi/pipeline-ai.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc -p tsconfig.build.json --noEmit",
    "upgrade-packages": "pnpm up --latest",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json": {
      "types": "./src/lib/normalize-ai-json.ts",
      "import": "./dist/lib/normalize-ai-json.js",
      "default": "./dist/lib/normalize-ai-json.js"
    },
    "./openai": {
      "types": "./src/lib/openai.ts",
      "import": "./dist/lib/openai.js",
      "default": "./dist/lib/openai.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "openai": "^7.5.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "~10.9.0",
    "openai": "^7.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  }
}
