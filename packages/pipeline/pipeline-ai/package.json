{
  "name": "@syrokomskyi/pipeline-ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc -p tsconfig.build.json --noEmit",
    "upgrade-packages": "pnpm up --latest",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@syrokomskyi/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json": {
      "@syrokomskyi/source": "./src/lib/normalize-ai-json.ts",
      "types": "./src/lib/normalize-ai-json.ts",
      "import": "./dist/lib/normalize-ai-json.js",
      "default": "./dist/lib/normalize-ai-json.js"
    },
    "./openai": {
      "@syrokomskyi/source": "./src/lib/openai.ts",
      "types": "./src/lib/openai.ts",
      "import": "./dist/lib/openai.js",
      "default": "./dist/lib/openai.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@syrokomskyi/pipeline-core": "workspace:*",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@eslint/js": "^10.0.1",
    "eslint": "~10.8.0",
    "openai": "^7.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.1.10"
  }
}
