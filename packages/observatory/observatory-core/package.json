{
  "name": "@syrokomskyi/observatory-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm exec vitest run",
    "lint": "pnpm exec eslint src --ext .ts",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@syrokomskyi/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ontology": {
      "@syrokomskyi/source": "./src/ontology/index.ts",
      "types": "./src/ontology/index.ts",
      "import": "./dist/ontology/index.js",
      "default": "./dist/ontology/index.js"
    },
    "./hashing": {
      "@syrokomskyi/source": "./src/hashing.ts",
      "types": "./src/hashing.ts",
      "import": "./dist/hashing.js",
      "default": "./dist/hashing.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1",
    "uuidv7": "^1.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "~10.8.0",
    "fast-check": "^4.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.1.10"
  }
}
