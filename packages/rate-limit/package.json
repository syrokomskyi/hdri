{
  "name": "@syrokomskyi/rate-limit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm exec vitest run",
    "changelog": "changelog-live",
    "changelog:init": "changelog-live init"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@syrokomskyi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@types/node": "^26.1.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
